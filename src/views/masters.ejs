<%- include('./includes/head', { pageTitle: 'Masters', pageStyle: 'masters' }) %>

<div class="ck-app">
  <%- include('./includes/sidebar', { page: 'masters', member }) %>

  <main class="ck-main">
    <header class="ck-topbar">
      <div>
        <span class="ck-topbar-kicker">WORKSPACE / TEAM</span>
        <h1>Our <em>masters.</em></h1>
      </div>
      <div class="ck-top-actions">
        <span class="ck-count-label"><%= masters ? masters.length : 0 %> professionals</span>
      </div>
    </header>

    <section class="ck-page-content">
      <div class="ck-toolbar">
        <div>
          <p class="ck-section-kicker">THE CREW</p>
          <h2>Craft is a team sport.</h2>
        </div>
        <input id="masterSearch" class="ck-search" type="search" placeholder="Search master..." />
      </div>

      <div class="ck-master-grid">
        <% if (masters && masters.length) { %>
          <% masters.forEach((m, i) => { %>
            <article class="ck-master-card" data-search="<%= String(m.memberNick || '').toLowerCase() %> <%= String(m.memberSpecialty || '').toLowerCase() %>">
              <div class="ck-master-card-top">
                <span class="ck-service-number">0<%= i + 1 %></span>
                <span class="ck-badge <%= String(m.memberStatus || '').toLowerCase() %>"><%= m.memberStatus %></span>
              </div>
              <div class="ck-master-profile">
                <div class="ck-master-large-avatar">
                  <% if (m.memberImage) { %><img src="/<%= m.memberImage %>" alt="<%= m.memberNick %>" /><% } else { %><span><%= m.memberNick ? m.memberNick.charAt(0).toUpperCase() : 'M' %></span><% } %>
                </div>
                <div>
                  <span class="ck-service-category">MASTER BARBER</span>
                  <h3><%= m.memberNick %></h3>
                  <p><%= m.memberSpecialty || 'Classic barbering' %></p>
                </div>
              </div>
              <div class="ck-master-meta">
                <div><small>EXPERIENCE</small><strong><%= m.memberExperience || '—' %></strong></div>
                <div><small>POINTS</small><strong><%= m.memberPoints || 0 %></strong></div>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <div class="ck-service-empty">
            <span>✦</span>
            <h3>No masters yet.</h3>
            <p>Your team will appear here once you add professionals.</p>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</div>

<script>
  document.getElementById('masterSearch')?.addEventListener('input', e => {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.ck-master-card').forEach(card => {
      card.style.display = card.dataset.search.includes(q) ? '' : 'none';
    });
  });
</script>

</body>
</html>
