<%- include('includes/header') %>
  <link rel="stylesheet" href="/css/admin.css" />

  <body>
    <div class="ck-wrap">
      <%- include('includes/sidebar', { page: 'services' , member }) %>

        <div class="ck-main">
          <div class="ck-topbar">
            <span class="ck-page-title">New Service</span>
            <div class="ck-topbar-right">
              <a href="/admin/services/all" class="btn btn-ghost btn-sm">← Back</a>
            </div>
          </div>

          <div class="ck-content">
            <div class="ck-panel" style="max-width:740px;">
              <div class="ck-panel-head">
                <span class="ck-panel-title">Service Details</span>
              </div>
              <div class="ck-panel-body">
                <form action="/admin/services/create" method="POST" enctype="multipart/form-data">

                  <div class="ck-form-grid">
                    <div class="ck-form-group">
                      <label class="ck-label">Service Name *</label>
                      <input class="ck-input" type="text" name="serviceName" placeholder="Signature Haircut" required />
                    </div>
                    <div class="ck-form-group">
                      <label class="ck-label">Category *</label>
                      <select class="ck-input ck-select" name="serviceCollection" required>
                        <option value="" disabled selected>Select category</option>
                        <option value="SIGNATURE">SIGNATURE</option>
                        <option value="HAIRCUT">HAIRCUT</option>
                        <option value="PERM">PERM</option>
                        <option value="BEARD">BEARD</option>
                        <option value="COLOR">COLOR</option>
                        <option value="SCALP_CARE">SCALP CARE</option>
                        <option value="STYLING">STYLING</option>
                        <option value="PACKAGE">PACKAGE</option>
                      </select>
                    </div>
                    <div class="ck-form-group">
                      <label class="ck-label">Price (₩) *</label>
                      <input class="ck-input" type="number" name="servicePrice" placeholder="45000" min="0" required />
                    </div>
                    <div class="ck-form-group">
                      <label class="ck-label">Duration (min) *</label>
                      <input class="ck-input" type="number" name="serviceDuration" placeholder="45" min="1" required />
                    </div>
                    <div class="ck-form-group ck-form-full">
                      <label class="ck-label">Description</label>
                      <textarea class="ck-input" name="serviceDesc" rows="3" placeholder="Describe this service..."
                        style="resize:vertical;"></textarea>
                    </div>
                    <div class="ck-form-group ck-form-full">
                      <label class="ck-label">Service Images (up to 5)</label>
                      <div class="ck-upload-grid">
                        <% for (let i=0; i < 5; i++) { %>
                          <label class="ck-upload-tile">
                            <input type="file" name="serviceImages" accept="image/jpg,image/jpeg,image/png"
                              onchange="ckPreview(this)" />
                            <img class="ck-upload-preview" />
                            <span class="ck-upload-remove" onclick="ckRemove(event, this)">
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                              </svg>
                            </span>
                            <div class="ck-upload-empty">
                              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19" />
                                <line x1="5" y1="12" x2="19" y2="12" />
                              </svg>
                              <span>
                                <%= i===0 ? 'Cover' : 'Photo' %>
                              </span>
                            </div>
                          </label>
                          <% } %>
                      </div>
                      <p class="ck-upload-hint">JPG, JPEG, PNG — the first photo is used as the cover image</p>
                    </div>
                  </div>

                  <div class="ck-form-actions">
                    <button type="submit" class="btn btn-gold" style="padding:12px 28px;">
                      Create Service
                    </button>
                    <a href="/admin/services/all" class="btn btn-ghost" style="padding:12px 28px;">
                      Cancel
                    </a>
                  </div>

                </form>
              </div>
            </div>
          </div>
        </div>
    </div>

    <script>
      function ckPreview(input) {
        const tile = input.closest('.ck-upload-tile');
        const img = tile.querySelector('.ck-upload-preview');
        if (input.files && input.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            img.src = e.target.result;
            img.style.display = 'block';
            tile.classList.add('has-image');
          };
          reader.readAsDataURL(input.files[0]);
        }
      }
      function ckRemove(e, btn) {
        e.preventDefault();
        e.stopPropagation();
        const tile = btn.closest('.ck-upload-tile');
        tile.querySelector('input[type="file"]').value = '';
        const img = tile.querySelector('.ck-upload-preview');
        img.src = '';
        img.style.display = 'none';
        tile.classList.remove('has-image');
      }
    </script>
  </body>
  <%- include('includes/footer') %>