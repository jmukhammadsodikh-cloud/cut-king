<%- include('includes/header') %>
  <link rel="stylesheet" href="/css/admin.css" />

  <body>
    <div class="ck-wrap">
      <%- include('includes/sidebar', { page: 'services' , member }) %>

        <div class="ck-main">
          <div class="ck-topbar">
            <span class="ck-page-title">Services</span>
            <div class="ck-topbar-right">
              <span class="ck-greeting">Total: <strong>
                  <%= services ? services.length : 0 %>
                </strong></span>
              <a href="/admin/services/create" class="btn btn-gold btn-sm">+ New Service</a>
            </div>
          </div>

          <div class="ck-content">
            <div class="ck-panel">
              <div class="ck-panel-head">
                <span class="ck-panel-title">All Services</span>
              </div>

              <div class="ck-filter-bar">
                <select class="ck-select" id="filterCollection">
                  <option value="">All categories</option>
                  <option value="SIGNATURE">SIGNATURE</option>
                  <option value="HAIRCUT">HAIRCUT</option>
                  <option value="PERM">PERM</option>
                  <option value="BEARD">BEARD</option>
                  <option value="COLOR">COLOR</option>
                  <option value="SCALP_CARE">SCALP CARE</option>
                  <option value="STYLING">STYLING</option>
                  <option value="PACKAGE">PACKAGE</option>
                </select>
                <select class="ck-select" id="filterStatus">
                  <option value="">All statuses</option>
                  <option value="PROCESS">PROCESS</option>
                  <option value="PAUSE">PAUSE</option>
                  <option value="DELETE">DELETE</option>
                </select>
                <input class="ck-input ck-search" id="filterSearch" type="text" placeholder="Search by service name…" />
              </div>

              <table class="ck-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Service Name</th>
                    <th>Category</th>
                    <th class="num">Duration</th>
                    <th class="num">Price</th>
                    <th class="center">Status</th>
                  </tr>
                </thead>
                <tbody id="servicesTbody">
                  <% if (services && services.length> 0) { %>
                    <% services.forEach((s, i)=> { %>
                      <tr data-collection="<%= s.serviceCollection %>" data-status="<%= s.serviceStatus %>"
                        data-name="<%= s.serviceName.toLowerCase() %>">
                        <td class="td-muted">
                          <%= i + 1 %>
                        </td>
                        <td class="td-name">
                          <%= s.serviceName %>
                        </td>
                        <td><span class="tag">
                            <%= s.serviceCollection %>
                          </span></td>
                        <td class="td-muted num">
                          <%= s.serviceDuration %> min
                        </td>
                        <td class="td-gold num">₩<%= s.servicePrice.toLocaleString() %>
                        </td>
                        <td class="center">
                          <select class="ck-pill-select service-status st-<%= s.serviceStatus.toLowerCase() %>"
                            id="<%= s._id %>">
                            <option value="PROCESS" <%=s.serviceStatus==='PROCESS' ? 'selected' : '' %>>PROCESS</option>
                            <option value="PAUSE" <%=s.serviceStatus==='PAUSE' ? 'selected' : '' %>>PAUSE</option>
                            <option value="DELETE" <%=s.serviceStatus==='DELETE' ? 'selected' : '' %>>DELETE</option>
                          </select>
                        </td>
                      </tr>
                      <% }) %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" class="ck-empty">
                              No services yet — <a href="/admin/services/create">Add your first service</a>
                            </td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
    </div>

    <script src="/js/services.js"></script>
    <script>
      // Lightweight client-side filter — no backend change needed
      (function () {
        const collectionSel = document.getElementById('filterCollection');
        const statusSel = document.getElementById('filterStatus');
        const searchInput = document.getElementById('filterSearch');
        const rows = document.querySelectorAll('#servicesTbody tr[data-name]');

        function applyFilters() {
          const c = collectionSel.value;
          const s = statusSel.value;
          const q = searchInput.value.trim().toLowerCase();
          rows.forEach(function (row) {
            const matchC = !c || row.dataset.collection === c;
            const matchS = !s || row.dataset.status === s;
            const matchQ = !q || row.dataset.name.includes(q);
            row.style.display = (matchC && matchS && matchQ) ? '' : 'none';
          });
        }
        [collectionSel, statusSel].forEach(function (el) { el && el.addEventListener('change', applyFilters); });
        searchInput && searchInput.addEventListener('input', applyFilters);
      })();
    </script>
  </body>
  <%- include('includes/footer') %>