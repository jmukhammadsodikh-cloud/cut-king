<%- include('./includes/head', { pageTitle: 'Services', pageStyle: 'services' }) %>

<div class="ck-app">
  <%- include('./includes/sidebar', { page: 'services', member }) %>

  <main class="ck-main">
    <header class="ck-topbar">
      <div>
        <span class="ck-topbar-kicker">WORKSPACE / CATALOG</span>
        <h1>Services <em>library.</em></h1>
      </div>
      <div class="ck-top-actions">
        <span class="ck-count-label"><%= services ? services.length : 0 %> services</span>
        <a href="/admin/services/create" class="ck-primary-btn ck-small-btn">+ New service</a>
      </div>
    </header>

    <section class="ck-page-content">
      <div class="ck-toolbar">
        <div>
          <p class="ck-section-kicker">CUTKING MENU</p>
          <h2>Every service, clearly defined.</h2>
        </div>
        <div class="ck-filter-row">
          <button class="ck-filter is-active" data-filter="ALL">All</button>
          <button class="ck-filter" data-filter="HAIRCUT">Haircut</button>
          <button class="ck-filter" data-filter="BEARD">Beard</button>
          <button class="ck-filter" data-filter="PACKAGE">Package</button>
          <input id="serviceSearch" class="ck-search" type="search" placeholder="Search service..." />
        </div>
      </div>

      <div class="ck-service-grid" id="serviceGrid">
        <% if (services && services.length) { %>
          <% services.forEach((s, i) => { %>
            <article class="ck-service-card" data-category="<%= s.serviceCollection %>" data-name="<%= String(s.serviceName || '').toLowerCase() %>">
              <div class="ck-service-card-top">
                <span class="ck-service-number">0<%= i + 1 %></span>
                <span class="ck-badge <%= String(s.serviceStatus || '').toLowerCase() %>"><%= s.serviceStatus %></span>
              </div>
              <div class="ck-service-card-main">
                <span class="ck-service-category"><%= s.serviceCollection %></span>
                <h3><%= s.serviceName %></h3>
                <p><%= s.serviceDesc || 'Professional CutKing service.' %></p>
              </div>
              <div class="ck-service-card-bottom">
                <div><small>DURATION</small><strong><%= s.serviceDuration %> MIN</strong></div>
                <div><small>PRICE</small><strong class="ck-price">₩<%= Number(s.servicePrice || 0).toLocaleString() %></strong></div>
                <a href="/admin/services/<%= s._id %>" aria-label="Edit service">↗</a>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <div class="ck-service-empty">
            <span>✂</span>
            <h3>Your menu is waiting.</h3>
            <p>Add your first CutKing service to start building the catalog.</p>
            <a href="/admin/services/create" class="ck-primary-btn">Create first service <span>↗</span></a>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</div>

<script>
(() => {
  const cards = [...document.querySelectorAll('.ck-service-card')];
  const buttons = [...document.querySelectorAll('.ck-filter')];
  const search = document.getElementById('serviceSearch');
  let category = 'ALL';

  function render() {
    const query = (search?.value || '').trim().toLowerCase();
    cards.forEach(card => {
      const matchCategory = category === 'ALL' || card.dataset.category === category;
      const matchSearch = !query || card.dataset.name.includes(query);
      card.style.display = matchCategory && matchSearch ? '' : 'none';
    });
  }

  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(b => b.classList.remove('is-active'));
    button.classList.add('is-active');
    category = button.dataset.filter;
    render();
  }));

  search?.addEventListener('input', render);
})();
</script>

</body>
</html>
