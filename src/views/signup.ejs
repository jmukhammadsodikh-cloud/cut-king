<%- include('./includes/head', { pageTitle: 'Signup' }) %>

<div class="ck-auth">
  <div class="ck-auth-box">
    <div class="ck-auth-logo">
      <h1>✂ CUT<span>KING</span></h1>
    </div>
    <p class="ck-auth-title">Create Admin Account</p>

    <% if (typeof err !== 'undefined' && err) { %>
      <div class="ck-auth-err" style="display:block"><%= err %></div>
    <% } %>

    <form action="/admin/signup" method="POST">
      <div class="ck-form-group">
        <label class="ck-label">SHOP NAME (NICK)</label>
        <input class="ck-input" type="text" name="memberNick" placeholder="cutking_official" required />
      </div>
      <div class="ck-form-group">
        <label class="ck-label">PHONE</label>
        <input class="ck-input" type="text" name="memberPhone" placeholder="010-0000-0000" required />
      </div>
      <div class="ck-form-group">
        <label class="ck-label">PASSWORD</label>
        <input class="ck-input" type="password" name="memberPassword" placeholder="••••••••" required />
      </div>
      <button type="submit" class="btn btn-gold" style="width:100%;justify-content:center;padding:12px;">
        CREATE ACCOUNT
      </button>
    </form>

    <div class="ck-auth-foot">
      Already have an account? <a href="/admin/login">Login</a>
    </div>
  </div>
</div>

</body>
</html>
