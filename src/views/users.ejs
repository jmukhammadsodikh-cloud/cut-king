<%- include('includes/header') %>
  <link rel="stylesheet" href="/css/admin.css" />

  <body>
    <div class="ck-wrap">
      <%- include('includes/sidebar', { page: 'users' , member }) %>

        <div class="ck-main">
          <div class="ck-topbar">
            <span class="ck-page-title">Users</span>
            <div class="ck-topbar-right">
              <span class="ck-greeting">Total: <strong>
                  <%= users ? users.length : 0 %>
                </strong> clients</span>
            </div>
          </div>

          <div class="ck-content">
            <div class="ck-panel">
              <div class="ck-panel-head">
                <span class="ck-panel-title">All Users</span>
              </div>

              <div class="ck-filter-bar">
                <select class="ck-select" id="filterStatus">
                  <option value="">All statuses</option>
                  <option value="ACTIVE">ACTIVE</option>
                  <option value="BLOCK">BLOCK</option>
                  <option value="DELETE">DELETE</option>
                </select>
                <input class="ck-input ck-search" id="filterSearch" type="text" placeholder="Search by nickname…" />
              </div>

              <table class="ck-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Nick</th>
                    <th>Phone</th>
                    <th class="num">Points</th>
                    <th>Joined</th>
                    <th class="center">Status</th>
                  </tr>
                </thead>
                <tbody id="usersTbody">
                  <% if (users && users.length> 0) { %>
                    <% users.forEach((u, i)=> { %>
                      <tr data-status="<%= u.memberStatus %>" data-name="<%= u.memberNick.toLowerCase() %>">
                        <td class="td-muted">
                          <%= i + 1 %>
                        </td>
                        <td class="td-name">
                          <%= u.memberNick %>
                        </td>
                        <td class="td-muted">
                          <%= u.memberPhone %>
                        </td>
                        <td class="td-gold num">
                          <%= u.memberPoints %>
                        </td>
                        <td class="td-muted">
                          <%= new Date(u.createdAt).toLocaleDateString('ko-KR') %>
                        </td>
                        <td class="center">
                          <select class="ck-pill-select member-status st-<%= u.memberStatus.toLowerCase() %>"
                            id="<%= u._id %>">
                            <option value="ACTIVE" <%=u.memberStatus==='ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                            <option value="BLOCK" <%=u.memberStatus==='BLOCK' ? 'selected' : '' %>>BLOCK</option>
                            <option value="DELETE" <%=u.memberStatus==='DELETE' ? 'selected' : '' %>>DELETE</option>
                          </select>
                        </td>
                      </tr>
                      <% }) %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" class="ck-empty">No users registered yet</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
    </div>

    <script src="/js/users.js"></script>
    <script>
      (function () {
        const statusSel = document.getElementById('filterStatus');
        const searchInput = document.getElementById('filterSearch');
        const rows = document.querySelectorAll('#usersTbody tr[data-name]');

        function applyFilters() {
          const st = statusSel.value;
          const q = searchInput.value.trim().toLowerCase();
          rows.forEach(function (row) {
            const matchSt = !st || row.dataset.status === st;
            const matchQ = !q || row.dataset.name.includes(q);
            row.style.display = (matchSt && matchQ) ? '' : 'none';
          });
        }
        statusSel && statusSel.addEventListener('change', applyFilters);
        searchInput && searchInput.addEventListener('input', applyFilters);
      })();
    </script>
  </body>
  <%- include('includes/footer') %>