<%- include('./includes/head', { pageTitle: 'Clients', pageStyle: 'users' }) %>

<div class="ck-app">
  <%- include('./includes/sidebar', { page: 'users', member }) %>

  <main class="ck-main">
    <header class="ck-topbar">
      <div>
        <span class="ck-topbar-kicker">WORKSPACE / PEOPLE</span>
        <h1>Client <em>directory.</em></h1>
      </div>
      <div class="ck-top-actions">
        <span class="ck-count-label"><%= users ? users.length : 0 %> clients</span>
      </div>
    </header>

    <section class="ck-page-content">
      <div class="ck-toolbar ck-people-toolbar">
        <div>
          <p class="ck-section-kicker">CLIENTS</p>
          <h2>Know who sits in your chair.</h2>
        </div>
        <input id="userSearch" class="ck-search" type="search" placeholder="Search by name or phone..." />
      </div>

      <section class="ck-dashboard-panel">
        <div class="ck-table-wrap">
          <table class="ck-table ck-people-table" id="usersTable">
            <thead>
              <tr><th>#</th><th>CLIENT</th><th>PHONE</th><th>POINTS</th><th>JOINED</th><th>STATUS</th><th></th></tr>
            </thead>
            <tbody>
              <% if (users && users.length) { %>
                <% users.forEach((u, i) => { %>
                  <tr data-search="<%= String(u.memberNick || '').toLowerCase() %> <%= String(u.memberPhone || '').toLowerCase() %>">
                    <td><span class="ck-row-index"><%= String(i + 1).padStart(2, '0') %></span></td>
                    <td><div class="ck-person-cell"><span class="ck-person-avatar"><%= u.memberNick ? u.memberNick.charAt(0).toUpperCase() : 'U' %></span><strong><%= u.memberNick %></strong></div></td>
                    <td class="ck-muted"><%= u.memberPhone %></td>
                    <td class="ck-price"><%= u.memberPoints || 0 %> pts</td>
                    <td class="ck-muted"><%= u.createdAt ? new Date(u.createdAt).toLocaleDateString('en-KR') : '—' %></td>
                    <td><span class="ck-badge <%= String(u.memberStatus || '').toLowerCase() %>"><%= u.memberStatus %></span></td>
                    <td><select class="ck-status-select user-status" id="<%= u._id %>"><option value="ACTIVE" <%= u.memberStatus === 'ACTIVE' ? 'selected' : '' %>>Active</option><option value="BLOCK" <%= u.memberStatus === 'BLOCK' ? 'selected' : '' %>>Blocked</option><option value="DELETE" <%= u.memberStatus === 'DELETE' ? 'selected' : '' %>>Deleted</option></select></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7" class="ck-empty-cell">No clients registered yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </section>
  </main>
</div>

<script>
  const userSearch = document.getElementById('userSearch');
  userSearch?.addEventListener('input', e => {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('#usersTable tbody tr[data-search]').forEach(row => {
      row.style.display = row.dataset.search.includes(q) ? '' : 'none';
    });
  });

  document.querySelectorAll('.user-status').forEach(sel => {
    sel.addEventListener('change', async function () {
      try {
        await fetch('/admin/user/edit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ _id: this.id, memberStatus: this.value })
        });
      } catch (err) {
        console.error('Status update failed:', err);
      }
    });
  });
</script>

</body>
</html>
