<%- include('includes/header') %>
  <link rel="stylesheet" href="/css/home.css" />

  <body>
    <div class="auth-container">
      <div class="auth-box">

        <div class="auth-logo">
          <div class="brand">✂ CUT<span>KING</span></div>
        </div>
        <div class="auth-sub">Admin Panel</div>
        <hr class="auth-divider" />

        <div class="auth-title">Welcome back</div>
        <div class="auth-caption">Sign in to manage your barbershop</div>

        <% if (typeof message !=='undefined' && message) { %>
          <div class="auth-err" style="display:block">
            <%= message %>
          </div>
          <% } %>

            <form action="/admin/login" method="POST">
              <div class="ck-form-group">
                <label class="ck-label">Barber Nick</label>
                <input class="ck-input" type="text" name="memberNick" placeholder="cutking_official" required
                  autocomplete="username" />
              </div>
              <div class="ck-form-group">
                <label class="ck-label">Password</label>
                <input class="ck-input" type="password" name="memberPassword" placeholder="••••••••" required
                  autocomplete="current-password" />
              </div>
              <button type="submit" class="btn btn-gold btn-full" style="padding:13px;">
                Login →
              </button>
            </form>

            <div class="auth-foot">
              No account? <a href="/admin/signup">Create one</a> ·
              <a href="/admin">Home</a>
            </div>
      </div>
    </div>
  </body>

  <%- include('includes/footer') %>