<aside class="ck-sidebar">
  <div class="ck-logo-area">
    <div class="ck-logo-brand">
      <span class="ck-logo-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="6" r="3" />
          <circle cx="6" cy="18" r="3" />
          <line x1="20" y1="4" x2="8.12" y2="15.88" />
          <line x1="14.47" y1="14.48" x2="20" y2="20" />
          <line x1="8.12" y1="8.12" x2="12" y2="12" />
        </svg>
      </span>
      CUT<span>KING</span>
    </div>
    <div class="ck-logo-tag">Admin Panel</div>
  </div>

  <nav class="ck-nav">
    <div class="ck-nav-group-label">Manage</div>

    <a href="/admin/services/all" class="ck-nav-link <%= page === 'services' ? 'active' : '' %>">
      <span class="nav-icon">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="6" r="3" />
          <circle cx="6" cy="18" r="3" />
          <line x1="20" y1="4" x2="8.12" y2="15.88" />
          <line x1="14.47" y1="14.48" x2="20" y2="20" />
          <line x1="8.12" y1="8.12" x2="12" y2="12" />
        </svg>
      </span>
      <span class="nav-label">Services</span>
    </a>

    <a href="/admin/master/all" class="ck-nav-link <%= page === 'masters' ? 'active' : '' %>">
      <span class="nav-icon">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2l2.9 6.26L21 9.27l-4.5 4.39L17.8 21 12 17.77 6.2 21l1.3-7.34L3 9.27l6.1-1.01L12 2z" />
        </svg>
      </span>
      <span class="nav-label">Masters</span>
    </a>

    <a href="/admin/user/all" class="ck-nav-link <%= page === 'users' ? 'active' : '' %>">
      <span class="nav-icon">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" />
          <circle cx="10" cy="7" r="4" />
          <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
      </span>
      <span class="nav-label">Users</span>
    </a>
  </nav>

  <div class="ck-sidebar-foot">
    <div class="ck-foot-row">
      <div class="ck-foot-avatar">
        <%= member && member.memberNick ? member.memberNick[0].toUpperCase() : 'A' %>
      </div>
      <div class="ck-foot-info">
        <div class="ck-foot-nick">
          <%= member ? member.memberNick : 'Admin' %>
        </div>
        <div class="ck-foot-role">Barber Shop</div>
      </div>
      <a href="/admin/logout" class="ck-logout-btn" title="Logout" onclick="return confirm('Logout?')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
      </a>
    </div>
  </div>
</aside>