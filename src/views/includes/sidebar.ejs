<aside class="ck-sidebar">
  <a href="/admin/dashboard" class="ck-brand">
    <span class="ck-brand-mark">CK</span>
    <span>
      <strong>CUT<span>KING</span></strong>
      <small>BARBERSHOP OS</small>
    </span>
  </a>

  <div class="ck-sidebar-section">
    <span class="ck-sidebar-label">WORKSPACE</span>

    <a href="/admin/dashboard" class="ck-side-link <%= page === 'dashboard' ? 'is-active' : '' %>">
      <span class="ck-side-icon">⌂</span>
      <span>Dashboard</span>
    </a>

    <a href="/admin/services/all" class="ck-side-link <%= page === 'services' ? 'is-active' : '' %>">
      <span class="ck-side-icon">✂</span>
      <span>Services</span>
    </a>

    <a href="/admin/master/all" class="ck-side-link <%= page === 'masters' ? 'is-active' : '' %>">
      <span class="ck-side-icon">✦</span>
      <span>Masters</span>
    </a>

    <a href="/admin/user/all" class="ck-side-link <%= page === 'users' ? 'is-active' : '' %>">
      <span class="ck-side-icon">◎</span>
      <span>Clients</span>
    </a>
  </div>

  <div class="ck-sidebar-section ck-sidebar-lower">
    <span class="ck-sidebar-label">ACCOUNT</span>
    <a href="/admin/logout" class="ck-side-link">
      <span class="ck-side-icon">↗</span>
      <span>Sign out</span>
    </a>
  </div>

  <div class="ck-profile-mini">
    <div class="ck-profile-avatar">
      <%= member && member.memberImage
        ? '<img src="/' + member.memberImage + '" alt="" />'
        : (member && member.memberNick ? member.memberNick.charAt(0).toUpperCase() : 'C') %>
    </div>
    <div class="ck-profile-copy">
      <strong><%= member ? member.memberNick : 'CutKing' %></strong>
      <span>Shop admin</span>
    </div>
    <span class="ck-live-dot"></span>
  </div>
</aside>
