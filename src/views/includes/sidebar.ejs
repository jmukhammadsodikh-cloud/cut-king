<aside class="ck-sidebar">
    <div class="ck-logo">
        <h1>✂ CUTKING</h1>
        <span>ADMIN PANEL</span>
    </div>

    <nav class="ck-nav">
        <div class="ck-nav-label">MAIN</div>
        <a href="/admin/dashboard" class="ck-nav-item <%= page === 'home' ? 'active' : '' %>">
            <span class="ck-nav-icon">⊞</span> Dashboard
        </a>
        <div class="ck-nav-label">MANAGE</div>
        <a href="/admin/service/all" class="ck-nav-item <%= page === 'services' ? 'active' : '' %>">
            <span class="ck-nav-icon">✂</span> Services
        </a>
        <a href="/admin/master/all" class="ck-nav-item <%= page === 'masters' ? 'active' : '' %>">
            <span class="ck-nav-icon">★</span> Masters
        </a>
        <a href="/admin/user/all" class="ck-nav-item <%= page === 'users' ? 'active' : '' %>">
            <span class="ck-nav-icon">◎</span> Users
        </a>
        <div class="ck-nav-label">ACCOUNT</div>
        <a href="/admin/logout" class="ck-nav-item">
            <span class="ck-nav-icon">→</span> Logout
        </a>
    </nav>

    <div class="ck-sidebar-foot">
        <div class="ck-admin-info">
            <div class="ck-avatar">
                <%= member ? member.memberNick[0].toUpperCase() : 'A' %>
            </div>
            <div>
                <div class="ck-admin-name">
                    <%= member ? member.memberNick : 'Admin' %>
                </div>
                <div class="ck-admin-role">Barber Shop</div>
            </div>
        </div>
    </div>
