<%- include('includes/header') %>
  <link rel="stylesheet" href="/css/admin.css" />

  <body>
    <div class="ck-wrap">
      <%- include('includes/sidebar', { page: 'home' , member }) %>

        <div class="ck-main">
          <div class="ck-topbar">
            <span class="ck-page-title">Dashboard</span>
            <div class="ck-topbar-right">
              <span class="ck-greeting">Good day, <strong>
                  <%= member ? member.memberNick : 'Admin' %>
                </strong></span>
              <a href="/admin/services/create" class="btn btn-ghost btn-sm">+ Service</a>
              <a href="/admin/master/create" class="btn btn-gold  btn-sm">+ Master</a>
            </div>
          </div>

          <div class="ck-content">

            <!-- STATS -->
            <div class="ck-stats">
              <div class="stat-card c-gold">
                <div class="stat-icon">✂</div>
                <div class="stat-lbl">Total Services</div>
                <div class="stat-val">
                  <%= services ? services.length : 0 %>
                </div>
                <div class="stat-hint">All categories</div>
              </div>
              <div class="stat-card c-green">
                <div class="stat-icon">◎</div>
                <div class="stat-lbl">Total Users</div>
                <div class="stat-val">
                  <%= users ? users.length : 0 %>
                </div>
                <div class="stat-hint">Registered clients</div>
              </div>
              <div class="stat-card c-blue">
                <div class="stat-icon">★</div>
                <div class="stat-lbl">Masters</div>
                <div class="stat-val">
                  <%= masters ? masters.length : 0 %>
                </div>
                <div class="stat-hint">Your team</div>
              </div>
              <div class="stat-card c-red">
                <div class="stat-icon">◷</div>
                <div class="stat-lbl">This Month</div>
                <div class="stat-val">–</div>
                <div class="stat-hint">Appointments</div>
              </div>
            </div>

            <!-- TWO COL -->
            <div class="ck-two-col">
              <!-- Services -->
              <div class="ck-panel">
                <div class="ck-panel-head">
                  <span class="ck-panel-title">Recent Services</span>
                  <a href="/admin/services/all" class="btn btn-ghost btn-sm">View all</a>
                </div>
                <table class="ck-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Service</th>
                      <th>Category</th>
                      <th>Price</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (services && services.length> 0) { %>
                      <% services.slice(0,5).forEach((s,i)=> { %>
                        <tr>
                          <td class="td-muted">
                            <%= i+1 %>
                          </td>
                          <td class="td-name">
                            <%= s.serviceName %>
                          </td>
                          <td class="td-muted">
                            <%= s.serviceCollection %>
                          </td>
                          <td class="td-gold">₩<%= s.servicePrice.toLocaleString() %>
                          </td>
                          <td><span class="badge badge-<%= s.serviceStatus.toLowerCase() %>">
                              <%= s.serviceStatus %>
                            </span></td>
                        </tr>
                        <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="5" class="ck-empty">No services yet — <a href="/admin/services/create">Add
                                  one</a></td>
                            </tr>
                            <% } %>
                  </tbody>
                </table>
              </div>

              <!-- Users -->
              <div class="ck-panel">
                <div class="ck-panel-head">
                  <span class="ck-panel-title">Recent Users</span>
                  <a href="/admin/user/all" class="btn btn-ghost btn-sm">View all</a>
                </div>
                <table class="ck-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Nick</th>
                      <th>Phone</th>
                      <th>Pts</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (users && users.length> 0) { %>
                      <% users.slice(0,5).forEach((u,i)=> { %>
                        <tr>
                          <td class="td-muted">
                            <%= i+1 %>
                          </td>
                          <td class="td-name">
                            <%= u.memberNick %>
                          </td>
                          <td class="td-muted">
                            <%= u.memberPhone %>
                          </td>
                          <td class="td-gold">
                            <%= u.memberPoints %>
                          </td>
                          <td><span class="badge badge-<%= u.memberStatus.toLowerCase() %>">
                              <%= u.memberStatus %>
                            </span></td>
                        </tr>
                        <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="5" class="ck-empty">No users yet</td>
                            </tr>
                            <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Masters -->
            <div class="ck-panel">
              <div class="ck-panel-head">
                <span class="ck-panel-title">Masters</span>
                <a href="/admin/master/all" class="btn btn-ghost btn-sm">View all</a>
              </div>
              <table class="ck-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Specialty</th>
                    <th>Experience</th>
                    <th>Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (masters && masters.length> 0) { %>
                    <% masters.forEach((m,i)=> { %>
                      <tr>
                        <td class="td-muted">
                          <%= i+1 %>
                        </td>
                        <td class="td-name">
                          <%= m.memberNick %>
                        </td>
                        <td class="td-muted">
                          <%= m.memberSpecialty || '—' %>
                        </td>
                        <td class="td-muted">
                          <%= m.memberExperience || '—' %>
                        </td>
                        <td><span class="badge badge-<%= m.memberStatus.toLowerCase() %>">
                            <%= m.memberStatus %>
                          </span></td>
                        <td><a href="/admin/master/<%= m._id %>/edit" class="btn btn-ghost btn-sm">Edit</a></td>
                      </tr>
                      <% }) %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" class="ck-empty">No masters yet — <a href="/admin/master/create">Add one</a>
                            </td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>

          </div>
        </div>
    </div>
  </body>
  <%- include('includes/footer') %>