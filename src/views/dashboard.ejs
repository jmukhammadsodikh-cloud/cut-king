<%- include('./includes/head', { pageTitle: 'Dashboard', pageStyle: 'dashboard' }) %>

<div class="ck-app">
  <%- include('./includes/sidebar', { page: 'dashboard', member }) %>

  <main class="ck-main">
    <header class="ck-topbar">
      <div>
        <span class="ck-topbar-kicker">WORKSPACE / OVERVIEW</span>
        <h1>Good to see you, <em><%= member ? member.memberNick : 'Admin' %>.</em></h1>
      </div>
      <div class="ck-top-actions">
        <span class="ck-status-pill"><i></i> Shop online</span>
        <a href="/admin/services/all" class="ck-outline-btn">View services</a>
        <a href="/admin/services/create" class="ck-primary-btn ck-small-btn">+ New service</a>
      </div>
    </header>

    <section class="ck-page-content">
      <div class="ck-dashboard-intro">
        <div>
          <p class="ck-section-kicker">TODAY'S CONTROL ROOM</p>
          <h2>Keep the chair moving.</h2>
          <p>One clean view of your shop's core data.</p>
        </div>
        <div class="ck-date-chip"><span>SEOUL</span><strong><%= new Date().toLocaleDateString('en-KR', { weekday: 'short', month: 'short', day: 'numeric' }) %></strong></div>
      </div>

      <div class="ck-stat-grid">
        <a href="/admin/services/all" class="ck-stat-card">
          <span class="ck-stat-index">01</span>
          <span class="ck-stat-label">SERVICES</span>
          <strong><%= services ? services.length : 0 %></strong>
          <small>Cataloged services <b>↗</b></small>
        </a>
        <a href="/admin/master/all" class="ck-stat-card">
          <span class="ck-stat-index">02</span>
          <span class="ck-stat-label">MASTERS</span>
          <strong><%= masters ? masters.length : 0 %></strong>
          <small>Shop professionals <b>↗</b></small>
        </a>
        <a href="/admin/user/all" class="ck-stat-card">
          <span class="ck-stat-index">03</span>
          <span class="ck-stat-label">CLIENTS</span>
          <strong><%= users ? users.length : 0 %></strong>
          <small>Registered clients <b>↗</b></small>
        </a>
        <div class="ck-stat-card ck-stat-dark">
          <span class="ck-stat-index">04</span>
          <span class="ck-stat-label">APPOINTMENTS</span>
          <strong>—</strong>
          <small>Booking module next <b>•</b></small>
        </div>
      </div>

      <div class="ck-dashboard-grid">
        <section class="ck-dashboard-panel ck-wide-panel">
          <div class="ck-panel-head">
            <div>
              <span class="ck-section-kicker">SERVICE CATALOG</span>
              <h3>Recent services</h3>
            </div>
            <a href="/admin/services/all" class="ck-text-link">View all ↗</a>
          </div>

          <div class="ck-table-wrap">
            <table class="ck-table">
              <thead>
                <tr><th>SERVICE</th><th>CATEGORY</th><th>TIME</th><th>PRICE</th><th>STATUS</th></tr>
              </thead>
              <tbody>
                <% if (services && services.length) { %>
                  <% services.slice(0, 5).forEach((s) => { %>
                    <tr>
                      <td class="ck-strong"><%= s.serviceName %></td>
                      <td><span class="ck-muted"><%= s.serviceCollection %></span></td>
                      <td><span class="ck-muted"><%= s.serviceDuration %> min</span></td>
                      <td class="ck-price">₩<%= Number(s.servicePrice || 0).toLocaleString() %></td>
                      <td><span class="ck-badge <%= String(s.serviceStatus || '').toLowerCase() %>"><%= s.serviceStatus %></span></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="ck-empty-cell">No services yet. Your catalog starts here.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="ck-dashboard-panel ck-quick-panel">
          <span class="ck-section-kicker">QUICK ACCESS</span>
          <h3>Build your shop.</h3>
          <p>Jump straight into the areas you manage most.</p>

          <a href="/admin/services/all" class="ck-quick-link"><span>✂</span><div><strong>Services</strong><small>Pricing & availability</small></div><b>↗</b></a>
          <a href="/admin/master/all" class="ck-quick-link"><span>✦</span><div><strong>Masters</strong><small>Team & specialties</small></div><b>↗</b></a>
          <a href="/admin/user/all" class="ck-quick-link"><span>◎</span><div><strong>Clients</strong><small>Customer directory</small></div><b>↗</b></a>
        </section>
      </div>

      <section class="ck-dashboard-panel">
        <div class="ck-panel-head">
          <div>
            <span class="ck-section-kicker">TEAM</span>
            <h3>Masters</h3>
          </div>
          <a href="/admin/master/all" class="ck-text-link">Manage team ↗</a>
        </div>

        <div class="ck-master-strip">
          <% if (masters && masters.length) { %>
            <% masters.slice(0, 5).forEach((m) => { %>
              <div class="ck-master-mini">
                <div class="ck-master-avatar"><%= m.memberNick ? m.memberNick.charAt(0).toUpperCase() : 'M' %></div>
                <div><strong><%= m.memberNick %></strong><span><%= m.memberSpecialty || 'BARBER' %></span></div>
                <i class="<%= String(m.memberStatus || '').toLowerCase() %>"></i>
              </div>
            <% }) %>
          <% } else { %>
            <div class="ck-empty-team">No masters registered yet. Add your first professional from the Masters page.</div>
          <% } %>
        </div>
      </section>
    </section>
  </main>
</div>

<script>
  document.querySelectorAll('.ck-stat-card').forEach(card => {
    card.addEventListener('mouseenter', () => card.classList.add('is-hovered'));
    card.addEventListener('mouseleave', () => card.classList.remove('is-hovered'));
  });
</script>

</body>
</html>
